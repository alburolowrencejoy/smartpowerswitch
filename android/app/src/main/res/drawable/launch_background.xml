<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen, shown before Flutter starts. Plain white so it
     hands off to the white power-on splash (lib/screens/shared/splash_screen.dart)
     without a flash. The emblem isn't drawn here: the splash starts from
     an empty ring and draws it in, so a static copy would pop out and back. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
</layer-list>
